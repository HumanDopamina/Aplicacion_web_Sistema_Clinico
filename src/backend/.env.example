DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secret-manager-value
DATABASE_URL=postgresql://user:password@database:5432/dentalclinic?sslmode=require
REDIS_URL=redis://cache:6379/0
ALLOWED_HOSTS=clinic.example.com
CSRF_TRUSTED_ORIGINS=https://clinic.example.com
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://clinic.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@example.com
AWS_STORAGE_BUCKET_NAME=clinic-public
AWS_PRIVATE_STORAGE_BUCKET_NAME=clinic-private
AWS_PUBLIC_MEDIA_PREFIX=public
AWS_PRIVATE_MEDIA_PREFIX=private
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
ENABLE_DJANGO_ADMIN=false
LOGIN_TRUSTED_PROXY_IPS=10.0.0.10

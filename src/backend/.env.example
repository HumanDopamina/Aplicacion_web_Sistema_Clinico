# Plantilla de producción: Django no carga este archivo automáticamente.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-secret-manager-value
DATABASE_URL=postgresql://user:password@database:5432/dentalclinic?sslmode=require
REDIS_URL=redis://cache:6379/0
ALLOWED_HOSTS=clinic.example.com
CSRF_TRUSTED_ORIGINS=https://clinic.example.com
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://clinic.example.com
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=10.0.0.10
HEALTHCHECK_HOST=clinic.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@example.com
AWS_STORAGE_BUCKET_NAME=clinic-public
AWS_PRIVATE_STORAGE_BUCKET_NAME=clinic-private
AWS_PUBLIC_MEDIA_PREFIX=public
AWS_PRIVATE_MEDIA_PREFIX=private
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
ENABLE_DJANGO_ADMIN=false
LOGIN_TRUSTED_PROXY_IPS=10.0.0.10

# Reservada para una integración futura; TEC-12 no requiere un proveedor SaaS.
SENTRY_DSN=
